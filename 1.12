<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Carregar Projeto</title>
  <style>
    body {
      display: flex;
      justify-content: center;
      align-items: center;
      height: 100vh;
      font-family: Arial, sans-serif;
      background-color: #121212;
      color: white;
      margin: 0;
    }
    button {
      padding: 15px 30px;
      font-size: 18px;
      cursor: pointer;
      border: none;
      border-radius: 8px;
      background-color: #238636;
      color: white;
      font-weight: bold;
      transition: 0.2s;
    }
    button:hover {
      background-color: #2ea043;
    }
  </style>
</head>
<body>

  <button id="btnAbrir">Carregar e Abrir Site</button>

  <script>
    document.getElementById('btnAbrir').addEventListener('click', async function() {
      const btn = this;
      btn.innerText = "Baixando do Drive...";
      btn.disabled = true;

      // Link direto de download do seu arquivo do Google Drive
      const fileId = '1jVgpl2m8ecQboh0aMiimj8SnmE8PCwK3';
      const driveUrl = `https://corsproxy.io/?https://drive.google.com/uc?export=download&id=${fileId}`;

      try {
        const response = await fetch(driveUrl);
        if (!response.ok) throw new Error("Erro na requisição");
        
        const htmlTexto = await response.text();

        // Abre a janela em about:blank e injeta o código pesado
        const novaJanela = window.open('about:blank', '_blank');
        
        if (novaJanela) {
          novaJanela.document.open();
          novaJanela.document.write(htmlTexto);
          novaJanela.document.close();
          btn.innerText = "Carregar e Abrir Site";
          btn.disabled = false;
        } else {
          alert('Por favor, permita os pop-ups do seu navegador.');
          btn.innerText = "Carregar e Abrir Site";
          btn.disabled = false;
        }

      } catch (erro) {
        console.error(erro);
        alert('Ocorreu um erro ao buscar o arquivo do Google Drive. Certifique-se de que o arquivo no Drive está com permissão pública de acesso (Qualquer pessoa com o link).');
        btn.innerText = "Carregar e Abrir Site";
        btn.disabled = false;
      }
    });
  </script>

</body>
</html>
